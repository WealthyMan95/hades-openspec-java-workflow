# Copy this file outside the repository or into a local ignored .env file.
# Do not commit real credentials.

# MySQL example for a MySQL MCP server that reads a URL-style DSN.
HADES_MYSQL_READONLY_URL=mysql://readonly_user:change-me@localhost:3306/app_db

# Optional generic DSN for non-MySQL database MCP servers.
HADES_DB_READONLY_URL=

# Optional write DSN. Prefer leaving this unset unless your team has explicit approval rules.
HADES_DB_WRITE_URL=
